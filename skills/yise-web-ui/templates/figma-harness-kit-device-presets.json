      "note": "伪本地化：基于 en-US 加重音符号并拉长约 1.5 倍，用于压测按钮与标签溢出" }
  ],
  "languageFallback": "en-US",

  "states": [
    { "group": "默认",     "items": [ { "key": "default", "name": "正常态" } ] },
    { "group": "加载",     "items": [
