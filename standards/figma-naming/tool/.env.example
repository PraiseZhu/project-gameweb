# Figma Personal Access Token（只需要 File content: read 权限）
# 生成：Figma → 头像菜单 → Settings → Security → Personal access tokens
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token

# 本地真稿的 Figma 文件 key —— 即 https://www.figma.com/design/<这一段>/... 里的那段。
# 它决定本地快照的文件名（.cache/<fileKey>-<nodeId>.json），是 npm run test:private
# 与 scripts/diagnostics/* 读真稿的唯一入口。真稿 key 填进 .env，不入 git（.gitignore 挡着）；
# 源码里不写死它，因为它指向的稿件是私有资产。下面这行只是示例值，照抄跑不通。
NAMING_LINT_FILE_KEY=TESTFILEKEY0000000001
