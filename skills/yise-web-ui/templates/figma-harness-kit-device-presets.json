    { "key": "zh-CN",  "name": "简体中文",         "ready": true },
    { "key": "zh-TW",  "name": "繁體中文",         "ready": true },
    { "key": "en-US",  "name": "English",          "ready": true },
    { "key": "ja-JP",  "name": "日本語",           "ready": true },
    { "key": "ko-KR",  "name": "한국어",           "ready": true },
    { "key": "de-DE",  "name": "Deutsch",          "ready": false },
