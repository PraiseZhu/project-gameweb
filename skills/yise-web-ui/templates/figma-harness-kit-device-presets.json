      { "key": "skeleton.partial", "name": "局部骨架" },
      { "key": "loading.more",     "name": "分页加载中" } ] },
    { "group": "空",       "items": [
      { "key": "empty.nodata", "name": "无数据" },
      { "key": "empty.search", "name": "无搜索结果" } ] },
    { "group": "错误",     "items": [
