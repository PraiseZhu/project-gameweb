    { "key": "ru-RU",  "name": "Русский",          "ready": false },
    { "key": "th-TH",  "name": "ไทย",              "ready": false },
    { "key": "vi-VN",  "name": "Tiếng Việt",       "ready": false },
    { "key": "id-ID",  "name": "Bahasa Indonesia", "ready": false },
